<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.knowthankyew.ntfsd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/kty-ntfsd</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.knowthankyew.ntfsd</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/kty-ntfsd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/kty-ntfsd.err</string>
</dict>
</plist>
